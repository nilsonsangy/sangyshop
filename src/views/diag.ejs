<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SangyShop - Posture Diagnostic</title>
<link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/navbar', { user: user }) %>
<main>
<%
  // Helpers de renderização — valores de dados sempre escapados no template.
  // Selo de estado reutilizando .state.on (seguro/robustecido) e .state.off (inseguro).
  function selo(classe, texto) {
    return '<span class="state ' + classe + '">' + texto + '</span>';
  }
  // Sinal indisponível: rótulo neutro + motivo (R9.3, R11.2).
  function indisponivel(motivo) {
    var m = (typeof motivo !== 'undefined' && motivo) ? motivo : 'motivo não informado';
    return { off: false, label: 'indisponível', motivo: String(m) };
  }
  var rpt = (typeof report !== 'undefined' && report) ? report : {};
%>
<h1>Diagnóstico de Postura</h1>
<p class="hint">
  Sinais coletados de dentro do container/Pod. Verde = robustecido/seguro, vermelho = inseguro.
  Sinais indisponíveis aparecem rotulados com o motivo.
</p>
<% if (rpt.meta) { %>
<p class="hint">
  Gerado em <%= rpt.meta.geradoEm %> · versão do relatório <%= rpt.meta.versaoRelatorio %>
</p>
<% } %>

<!-- Identidade de execução (R2) -->
<section class="diag-group">
  <h2>Identidade de execução</h2>
  <% var s = rpt.identidadeExecucao || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Papel</th>
        <td>
          <%= s.papel %>
          <% if (s.isRoot) { %><%- selo('off', 'root (inseguro)') %><% } else { %><%- selo('on', 'não-root (robustecido)') %><% } %>
        </td>
      </tr>
      <tr><th>uid</th><td><%= s.uid %></td></tr>
      <tr><th>gid</th><td><%= s.gid %></td></tr>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Privilégio (R3) -->
<section class="diag-group">
  <h2>Indícios de privilégio</h2>
  <% var s = rpt.privilegio || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr><th>Capabilities efetivas (CapEff)</th><td><code><%= (typeof s.capEff !== 'undefined' && s.capEff !== null) ? s.capEff : 'indisponível' %></code></td></tr>
      <tr><th>Capabilities permitidas (CapPrm)</th><td><code><%= (typeof s.capPrm !== 'undefined' && s.capPrm !== null) ? s.capPrm : 'indisponível' %></code></td></tr>
      <tr>
        <th>Montagem do nó (/host)</th>
        <td><% if (s.montagemNoPresente) { %><%- selo('off', 'presente (inseguro)') %><% } else { %><%- selo('on', 'ausente (robustecido)') %><% } %></td>
      </tr>
      <tr>
        <th>Visibilidade de processos do nó (hostPID)</th>
        <td><% if (s.hostPidProvavel) { %><%- selo('off', 'provável (inseguro)') %><% } else { %><%- selo('on', 'improvável (robustecido)') %><% } %></td>
      </tr>
      <% if (s.metodo) { %><tr><th>Método</th><td class="hint"><%= s.metodo %></td></tr><% } %>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Sistema de arquivos (R4) -->
<section class="diag-group">
  <h2>Sistema de arquivos</h2>
  <% var s = rpt.sistemaArquivos || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Rootfs somente leitura</th>
        <td><% if (s.rootfsSomenteLeitura) { %><%- selo('on', 'somente leitura (robustecido)') %><% } else { %><%- selo('off', 'gravável (inseguro)') %><% } %></td>
      </tr>
      <% if (s.caminhoTestado) { %><tr><th>Caminho testado</th><td><code><%= s.caminhoTestado %></code></td></tr><% } %>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Token de ServiceAccount (R5) -->
<section class="diag-group">
  <h2>Token de ServiceAccount</h2>
  <% var s = rpt.tokenServiceAccount || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Token montado</th>
        <td><% if (s.tokenMontado) { %><%- selo('off', 'montado (inseguro)') %><% } else { %><%- selo('on', 'não montado (robustecido)') %><% } %></td>
      </tr>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Rede e host (R6) -->
<section class="diag-group">
  <h2>Rede e host</h2>
  <% var s = rpt.redeHost || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr><th>Hostname</th><td><code><%= s.hostname %></code></td></tr>
      <tr>
        <th>Rede do host (hostNetwork)</th>
        <td><% if (s.hostNetworkProvavel) { %><%- selo('off', 'provável (inseguro)') %><% } else { %><%- selo('on', 'improvável (robustecido)') %><% } %></td>
      </tr>
      <tr>
        <th>Montagem do nó (/host)</th>
        <td><% if (s.montagemNoPresente) { %><%- selo('off', 'presente (inseguro)') %><% } else { %><%- selo('on', 'ausente (robustecido)') %><% } %></td>
      </tr>
      <% if (s.metodo) { %><tr><th>Método</th><td class="hint"><%= s.metodo %></td></tr><% } %>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Identidade do Pod (R7) — estrutura aninhada -->
<section class="diag-group">
  <h2>Identidade do Pod</h2>
  <% var s = rpt.identidadePod || {}; %>
  <table><tbody>
    <%
      var campos = [
        { rotulo: 'Nome', campo: s.nome },
        { rotulo: 'Namespace', campo: s.namespace },
        { rotulo: 'Nó', campo: s.no }
      ];
    %>
    <% campos.forEach(function(c){ var f = c.campo || {}; %>
      <tr>
        <th><%= c.rotulo %></th>
        <td>
          <% if (f.disponivel) { %>
            <code><%= f.valor %></code>
          <% } else { var d = indisponivel(f.motivo); %>
            <span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody></table>
</section>

<!-- Variáveis sensíveis (R8) — apenas presença, nunca valor -->
<section class="diag-group">
  <h2>Variáveis sensíveis</h2>
  <% var s = rpt.variaveisSensiveis || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>DB_PASSWORD presente</th>
        <td>
          <% if (s.dbPasswordPresente) { %><%- selo('off', 'presente (só nome, valor não exposto)') %><% } else { %><%- selo('on', 'ausente') %><% } %>
        </td>
      </tr>
    </tbody></table>
  <% } else { var d = indisponivel(s.motivo); %>
    <p><span class="state off">indisponível</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

</main></body></html>
