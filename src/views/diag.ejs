<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SangyShop - Posture Diagnostic</title>
<link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/navbar', { user: user }) %>
<main>
<%
  // Rendering helpers: data values are always escaped in the template.
  // State badge reusing .state.on (safe/hardened) and .state.off (insecure).
  function badge(classe, texto) {
    return '<span class="state ' + classe + '">' + texto + '</span>';
  }
  // Unavailable signal: neutral label + reason (R9.3, R11.2).
  function unavailable(motivo) {
    var m = (typeof motivo !== 'undefined' && motivo) ? motivo : 'no reason provided';
    return { off: false, label: 'unavailable', motivo: String(m) };
  }
  var rpt = (typeof report !== 'undefined' && report) ? report : {};
%>
<h1>Posture Diagnostic</h1>
<p class="hint">
  Signals collected from inside the container/Pod. Green = hardened/safe, red = insecure.
  Unavailable signals are labeled with the reason.
</p>
<p class="hint">
  A02 (Security Misconfiguration) covers the security headers and the error page
  <code>/debug/boom</code> (which leaks the stack trace when the defense is off). Since
  that error page is plain text, the EJS entry point of the A02 "View code" is here.
</p>
<%- include('partials/view-code', { vuln: 'A02' }) %>
<% if (rpt.meta) { %>
<p class="hint">
  Generated at <%= rpt.meta.geradoEm %> | report version <%= rpt.meta.reportVersion %>
</p>
<% } %>

<!-- Execution identity (R2) -->
<section class="diag-group">
  <h2>Execution identity</h2>
  <% var s = rpt.executionIdentity || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Role</th>
        <td>
          <%= s.papel %>
          <% if (s.isRoot) { %><%- badge('off', 'root (insecure)') %><% } else { %><%- badge('on', 'non-root (hardened)') %><% } %>
        </td>
      </tr>
      <tr><th>uid</th><td><%= s.uid %></td></tr>
      <tr><th>gid</th><td><%= s.gid %></td></tr>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Privilege (R3) -->
<section class="diag-group">
  <h2>Privilege indicators</h2>
  <% var s = rpt.privilegio || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr><th>Effective capabilities (CapEff)</th><td><code><%= (typeof s.capEff !== 'undefined' && s.capEff !== null) ? s.capEff : 'unavailable' %></code></td></tr>
      <tr><th>Permitted capabilities (CapPrm)</th><td><code><%= (typeof s.capPrm !== 'undefined' && s.capPrm !== null) ? s.capPrm : 'unavailable' %></code></td></tr>
      <tr>
        <th>Node mount (/host)</th>
        <td><% if (s.montagemNoPresente) { %><%- badge('off', 'present (insecure)') %><% } else { %><%- badge('on', 'absent (hardened)') %><% } %></td>
      </tr>
      <tr>
        <th>Node process visibility (hostPID)</th>
        <td><% if (s.likelyHostPid) { %><%- badge('off', 'likely (insecure)') %><% } else { %><%- badge('on', 'unlikely (hardened)') %><% } %></td>
      </tr>
      <% if (s.metodo) { %><tr><th>Method</th><td class="hint"><%= s.metodo %></td></tr><% } %>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Filesystem (R4) -->
<section class="diag-group">
  <h2>Filesystem</h2>
  <% var s = rpt.sistemaArquivos || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Read-only rootfs</th>
        <td><% if (s.rootfsSomenteLeitura) { %><%- badge('on', 'read-only (hardened)') %><% } else { %><%- badge('off', 'writable (insecure)') %><% } %></td>
      </tr>
      <% if (s.testedPath) { %><tr><th>Tested path</th><td><code><%= s.testedPath %></code></td></tr><% } %>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- ServiceAccount token (R5) -->
<section class="diag-group">
  <h2>ServiceAccount token</h2>
  <% var s = rpt.tokenServiceAccount || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>Token mounted</th>
        <td><% if (s.tokenMontado) { %><%- badge('off', 'mounted (insecure)') %><% } else { %><%- badge('on', 'not mounted (hardened)') %><% } %></td>
      </tr>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Network and host (R6) -->
<section class="diag-group">
  <h2>Network and host</h2>
  <% var s = rpt.redeHost || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr><th>Hostname</th><td><code><%= s.hostname %></code></td></tr>
      <tr>
        <th>Host network (hostNetwork)</th>
        <td><% if (s.likelyHostNetwork) { %><%- badge('off', 'likely (insecure)') %><% } else { %><%- badge('on', 'unlikely (hardened)') %><% } %></td>
      </tr>
      <tr>
        <th>Node mount (/host)</th>
        <td><% if (s.montagemNoPresente) { %><%- badge('off', 'present (insecure)') %><% } else { %><%- badge('on', 'absent (hardened)') %><% } %></td>
      </tr>
      <% if (s.metodo) { %><tr><th>Method</th><td class="hint"><%= s.metodo %></td></tr><% } %>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

<!-- Pod identity (R7): nested structure -->
<section class="diag-group">
  <h2>Pod identity</h2>
  <% var s = rpt.podIdentity || {}; %>
  <table><tbody>
    <%
      var campos = [
        { rotulo: 'Name', campo: s.nome },
        { rotulo: 'Namespace', campo: s.namespace },
        { rotulo: 'Node', campo: s.no }
      ];
    %>
    <% campos.forEach(function(c){ var f = c.campo || {}; %>
      <tr>
        <th><%= c.rotulo %></th>
        <td>
          <% if (f.disponivel) { %>
            <code><%= f.valor %></code>
          <% } else { var d = unavailable(f.motivo); %>
            <span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </tbody></table>
</section>

<!-- Sensitive variables (R8): presence only, never the value -->
<section class="diag-group">
  <h2>Sensitive variables</h2>
  <% var s = rpt.variaveisSensiveis || {}; %>
  <% if (s.disponivel) { %>
    <table><tbody>
      <tr>
        <th>DB_PASSWORD present</th>
        <td>
          <% if (s.dbPasswordPresente) { %><%- badge('off', 'present (name only, value not exposed)') %><% } else { %><%- badge('on', 'absent') %><% } %>
        </td>
      </tr>
    </tbody></table>
  <% } else { var d = unavailable(s.motivo); %>
    <p><span class="state off">unavailable</span> <span class="hint"><%= d.motivo %></span></p>
  <% } %>
</section>

</main></body></html>
