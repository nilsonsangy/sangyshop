<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SangyShop - Logs</title>
<link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/navbar', { user: user }) %>
<main>
<h1>Authentication logs (A09)</h1>
<p class="hint">With the A09 defense turned off, nothing shows up here: the attack goes unnoticed. Turn it on and replay the brute force.</p>
<% if (lines.length === 0) { %><p class="error">No events recorded.</p><% } else { %>
<pre class="log"><% lines.forEach(function(l){ %><%= l %>
<% }); %></pre>
<% } %>
</main></body></html>
