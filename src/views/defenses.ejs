<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SangyShop - Defenses Panel</title>
<link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/navbar', { user: user }) %>
<main>
<h1>Defenses Panel (Blue Team)</h1>
<p class="hint">Turn each defense on, replay the same attack and compare the result. Toggle OFF = vulnerable; ON = mitigated.</p>
<form method="post" action="/defenses">
<% Object.keys(labels).forEach(function(key){ %>
<label class="toggle">
<input type="checkbox" name="<%= key %>" <%= defenses[key] ? "checked" : "" %>>
<span class="state <%= defenses[key] ? 'on' : 'off' %>"><%= defenses[key] ? "ON" : "OFF" %></span>
<%= labels[key] %>
</label>
<% }); %>
<button type="submit">Save defenses</button>
</form>
<pre class="sql">Via terminal: curl -X POST .../api/defenses/A05_injection -H "Content-Type: application/json" -d "{\"value\":true}"</pre>
</main></body></html>
