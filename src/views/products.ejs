<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>SangyShop - Store</title>
<link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/navbar', { user: user }) %>
<main>
<h1>Catalog</h1>
<form method="get" action="/products" class="search">
<input name="q" value="<%= q %>" placeholder="Search products...">
<button type="submit">Search</button>
</form>
<% if (sqlShown) { %><pre class="sql">SQL executed: <%= sqlShown %></pre><% } %>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<table><thead><tr><th>#</th><th>Product</th><th>Description</th><th>Price</th></tr></thead><tbody>
<% products.forEach(function(p){ %>
<tr><td><%= p.id %></td><td><%= p.name %></td><td><%= p.description %></td><td>$ <%= Number(p.price).toFixed(2) %></td></tr>
<% }); %>
</tbody></table>
</main></body></html>
