<% var highlightLabel = (highlight === 'secure') ? 'trecho seguro (defesa ligada)' : 'trecho vulneravel (defesa desligada)'; %>
<section class="code-snippet" data-vuln="<%= vuln %>" data-highlight="<%= highlight %>">
<% if (unavailable) { %>
  <p class="code-unavailable" role="alert">
    Código-fonte indisponível no momento: <%= unavailable %>.
    A página segue navegável; tente novamente.
  </p>
<% } else { %>
  <header class="code-snippet-head">
    <span class="code-file"><%= file %></span>
    <% if (defenseKey) { %>
      <span class="code-defense">Defesa: <%= defenseKey %></span>
    <% } else { %>
      <span class="code-defense">Sem toggle de defesa</span>
    <% } %>
    <span class="code-highlight-note">Destaque: <%= highlightLabel %></span>
  </header>
  <pre class="code-block"><% blocks.forEach(function (b) { %><span class="code-section<%= b.active ? ' code-active' : '' %>" data-state="<%= b.state %>" title="<%= b.label %>"><%= b.code %></span><% }) %></pre>
<% } %>
</section>
